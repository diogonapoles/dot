[manager]
show_hidden = true
sort_dir_first = true

[preview]
image_delay = 10

[[opener.edit]]
run = 'nvim "$@"'
block = true
desc = "nvim"
for = "unix"

[[opener.zathura]]
run = 'zathura "$@"'
orphan = true
desc = "zathura"
for = "unix"

[[open.rules]]
mime = "text/*"
use = ["edit"]

[[open.rules]]
mime = "application/pdf"
use = ["zathura"]
